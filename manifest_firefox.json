{
    "manifest_version": 3,
    "name": "OmniTime: Time Tracking",
    "version": "2.1.0",
    "description": "Retrieves time tracking data from an external provider and embeds it into ticket management systems.",
    "author": "Hristo Chonov",
    "permissions": [
        "storage",
        "scripting",
        "alarms",
        "unlimitedStorage",
        "identity",
        "notifications",
        "contextMenus"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "background": {
        "scripts": [
            "ical-parser.js",
            "background.js"
        ]
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "web_accessible_resources": [
        {
            "resources": [
                "options.html",
                "options.css",
                "options.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "omnitime@hristo.chonov.gmail.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}