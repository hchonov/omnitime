{
  "name": "omnitime-dev",
  "private": true,
  "version": "1.0.0",
  "description": "Local dev preview harness for the OmniTime extension UI. Not part of the shipped extension.",
  "scripts": {
    "dev": "node dev/server.mjs",
    "test": "node --test tests/*.test.js",
    "build:dev": "./build_extension.sh --dev > /dev/null && rm -rf dist/omnitime && unzip -q dist/omnitime.zip -d dist/omnitime",
    "test:e2e": "npm run build:dev && playwright test",
    "e2e:session": "npm run build:dev && node e2e/session.js"
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
