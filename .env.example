# OmniTime dev preview config (local only). Copy to ".env" and fill in.
# The ".env" file is git-ignored and is NOT shipped in the built extension —
# it only seeds defaults for `npm run dev` (the preview harness).

# Your time-tracking API tracked-time endpoint. The sibling endpoints
# (my-tracked-time / frequent-issues / issue-search / time-entry) are derived.
OMNITIME_API_URL=https://your-site.example/api/v1/tracked-time

# Your personal key_auth token. Stays server-side (the dev proxy injects it);
# it is never written into the preview page.
OMNITIME_API_KEY=

# Defaults for the simulated "current issue" in the preview (the values your
# GitLab adapter would extract on a real ticket page).
OMNITIME_SOURCE=https://your-gitlab.example
OMNITIME_PROJECT_ID=123
OMNITIME_ISSUE_ID=456
OMNITIME_ISSUE_LABEL=Example issue (#456)
