{
  "manifest_version": 3,
  "name": "OmniTime: Time Tracking",
  "version": "2.0.4",
  "description": "Retrieves time tracking data from an external provider and embeds it into ticket management systems.",
  "author": "Hristo Chonov",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "unlimitedStorage",
    "identity",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "options.html",
        "options.css",
        "options.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "minimum_chrome_version": "102",
  "oauth2": {
    "client_id": "865706468431-nj649djh85hb1fve603321ks6n05art0.apps.googleusercontent.com",
    "scopes": [
      "email",
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  }
}